---
import { hero } from "../../data/sections";
import { SECTION_IDS } from "../../data/site";
import Container from "../ui/Container.astro";
import CtaButton from "../ui/CtaButton.astro";
import Placeholder from "../ui/Placeholder.astro";
---

<section id={SECTION_IDS.hero} class="scroll-mt-24 py-16 md:py-24">
	<Container class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
		<div>
			<p class="text-xs font-medium uppercase tracking-[0.14em] text-secondary-teal">
				{hero.tagline}
			</p>
			<h1 class="mt-6 text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">
				{hero.headline}<span class="text-secondary-teal">.</span>
			</h1>
			<p class="mt-6 max-w-[60ch] text-lg md:text-xl">{hero.intro}</p>
			<CtaButton href={hero.cta.href} class="mt-10">{hero.cta.label}</CtaButton>
		</div>
		<Placeholder ratio="4/3" label="Hero image" />
	</Container>
</section>
