---
import { Image } from "astro:assets";
import heroImage from "../../assets/hero-image.png";
import { hero } from "../../data/sections";
import { SECTION_IDS } from "../../data/site";
import Container from "../ui/Container.astro";
import CtaButton from "../ui/CtaButton.astro";
---

<section
	id={SECTION_IDS.hero}
	class="relative scroll-mt-24 overflow-hidden py-16 md:py-24"
>
	<Container class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <p
        class="text-xs font-medium uppercase tracking-[0.14em] text-secondary-teal"
      >
        {hero.tagline}
      </p>
      <h1 class="mt-6 text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">
        {hero.headline}<span class="text-secondary-teal">.</span>
      </h1>
      <p class="mt-6 max-w-[60ch] text-lg md:text-xl">{hero.intro}</p>
      <CtaButton href={hero.cta.href} class="mt-10">{hero.cta.label}</CtaButton>
    </div>
		<Image
			src={heroImage}
			alt=""
			widths={[480, 640, 778, 960, 1280, 1600, 1920, 2560, 3112]}
			sizes="(min-width: 1024px) 50vw, calc(100vw - 2rem)"
			loading="eager"
			decoding="async"
			class="w-full lg:absolute lg:inset-y-0 lg:right-0 lg:h-full lg:w-1/2 lg:object-contain lg:object-right"
		/>
  </Container>
</section>
