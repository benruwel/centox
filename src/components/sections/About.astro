---
import { about } from "../../data/sections";
import { SECTION_IDS } from "../../data/site";
import Section from "../ui/Section.astro";
---

<Section
  id={SECTION_IDS.about}
  eyebrow="About us"
  heading="Science that turns complex questions into clear answers"
  class="bg-surface-subtle"
>
  <div>
    <p class="max-w-[66ch] text-lg leading-8 text-primary-slate md:text-xl md:leading-9">
      {about.introduction}
    </p>
  </div>

  <ol role="list" class="mt-14 grid border-y border-hairline md:grid-cols-3">
    {
      about.pillars.map((pillar, index) => (
        <li class:list={[
          "py-8 md:px-8 md:py-10",
          index > 0 && "border-t border-hairline md:border-l md:border-t-0",
          index === 0 && "md:pl-0",
        ]}>
          <span class="font-display text-xs font-semibold tracking-[0.14em] text-secondary-teal">
            {pillar.number}
          </span>
          <h3 class="mt-5 text-xl">{pillar.title}</h3>
          <p class="mt-3 max-w-[42ch] leading-7">{pillar.description}</p>
        </li>
      ))
    }
  </ol>

  <p class="mt-10 max-w-4xl leading-7">{about.closing}</p>
</Section>
