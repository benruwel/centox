---
import {
	Clock,
	Lock,
	Microscope,
	ShieldCheck,
	Target,
	Users,
} from "@lucide/astro";
import { whyUs } from "../../data/sections";
import { SECTION_IDS } from "../../data/site";
import Section from "../ui/Section.astro";

const CARD_LAYOUT = {
	turnaround: "md:col-span-3",
	technology: "md:col-span-3",
	accuracy: "md:col-span-4",
	confidentiality: "md:col-span-2",
	professionals: "md:col-span-2",
	quality: "md:col-span-4",
} as const;

const ITEM_ICONS = {
	turnaround: Clock,
	technology: Microscope,
	accuracy: Target,
	confidentiality: Lock,
	professionals: Users,
	quality: ShieldCheck,
} as const;
---

<Section id={SECTION_IDS.whyUs} eyebrow="Advantage" heading="Why Choose Us?">
  {
    /* role="list" restores semantics that preflight's list-style:none strips in Safari/VoiceOver */
  }
  <ul role="list" class="grid gap-2 md:grid-cols-6">
    {
      whyUs.map((item) => {
        const ItemIcon = ITEM_ICONS[item.id];

        return (
          <li
            class:list={[
              "flex min-h-52 flex-col border border-hairline bg-surface-subtle p-6 sm:p-8",
              CARD_LAYOUT[item.id],
            ]}
          >
            <div class="text-secondary-teal">
              <ItemIcon
                aria-hidden="true"
                stroke-width={1.75}
                class="size-7"
              />
            </div>
            <div class="mt-auto pt-10">
              <h3 class="text-lg">{item.title}</h3>
              <p class="mt-2 max-w-[52ch] text-sm">{item.description}</p>
            </div>
          </li>
        );
      })
    }
  </ul>
</Section>
