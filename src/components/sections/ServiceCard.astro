---
import { Image } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import type { ServiceCategory } from "../../data/services";

interface Props {
	category: ServiceCategory;
	wide?: boolean;
	class?: string;
}

const { category, wide = false, class: className = "" } = Astro.props;
const href = `/services#${category.sectionId}`;

const responsiveWidths = [
	320,
	480,
	640,
	960,
	1280,
	1600,
	1920,
	2560,
	3200,
	3840,
	category.image.width,
].filter(
	(width, index, widths) =>
		width <= category.image.width && widths.indexOf(width) === index,
);
---

<li class:list={["flex flex-col bg-paper", wide && "sm:flex-row", className]}>
  {
    /*
    Fixed 16/9 above the text, so the grid rows line up whatever the source
    ratio is. The wide card instead lets the photo stretch to the height of the
    copy beside it — hence aspect-auto. object-cover crops rather than distorts
    in both cases.
  */
  }
  <a
    href={href}
    aria-label={`Learn more about ${category.title}`}
    data-service-transition={category.sectionId}
    data-transition-part="image"
    class:list={[
      "group block aspect-video w-full overflow-hidden bg-ink",
      wide && "sm:aspect-auto sm:w-1/2 sm:self-stretch",
    ]}
  >
    <Image
      src={category.image}
      alt={category.imageAlt}
      widths={responsiveWidths}
      sizes="(min-width: 640px) 50vw, 100vw"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-[transform,opacity] duration-500 ease-in-out motion-safe:md:group-hover:scale-105 md:group-hover:opacity-70"
    />
  </a>
  <div class="flex flex-1 flex-col py-6 sm:p-6 md:p-8">
    <h3 class="text-lg">
      <a
        href={href}
        data-service-transition={category.sectionId}
        data-transition-part="title"
        class="group/title inline-flex items-center gap-2 decoration-secondary-teal underline-offset-4 hover:underline"
      >
        {category.title}
        <ArrowUpRight
          aria-hidden="true"
          stroke-width={1.75}
          class="size-4 text-secondary-teal motion-safe:transition-transform motion-safe:group-hover/title:-translate-y-px motion-safe:group-hover/title:translate-x-px"
        />
      </a>
    </h3>
    <p class="mt-2 text-sm">{category.summary}</p>
  </div>
</li>
