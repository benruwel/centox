---
import logo from "../../assets/centox-standard-logo.svg";
import darkLogo from "../../assets/centox-standard-logo-dark.svg";
import { SECTION_IDS, siteConfig } from "../../data/site";

interface Props {
  tone?: "light" | "dark";
  height?: "compact" | "large";
  class?: string;
}

const {
  tone = "light",
  height = "compact",
  class: className = "",
} = Astro.props;
const selectedLogo = tone === "dark" ? darkLogo : logo;
const heightClass = height === "large" ? "h-16" : "h-8";
---

<a
  href={`/#${SECTION_IDS.hero}`}
  aria-label={`${siteConfig.name}, home`}
  class:list={["inline-flex items-center", className]}
>
  <img
    src={selectedLogo.src}
    alt=""
    width={selectedLogo.width}
    height={selectedLogo.height}
    loading="eager"
    decoding="sync"
    class:list={[heightClass, "w-auto"]}
  />
</a>
