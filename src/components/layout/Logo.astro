---
import { Image } from "astro:assets";
import mark from "../../assets/centox-mark.png";
import { SECTION_IDS, siteConfig } from "../../data/site";

interface Props {
	tone?: "light" | "dark";
	class?: string;
}

const { tone = "light", class: className = "" } = Astro.props;
---

<a
  href={`/#${SECTION_IDS.hero}`}
  aria-label={`${siteConfig.name}, home`}
  class:list={["inline-flex items-center gap-2.5", className]}
>
  {/* alt="" because the adjacent wordmark already names the organisation */}
  <Image
    src={mark}
    alt=""
    width={44}
    densities={[1, 2]}
    loading="eager"
    decoding="sync"
    class="h-7 w-auto"
  />
  <span
    class:list={[
      "font-display text-base font-extrabold tracking-tight sm:text-lg",
      tone === "dark" ? "text-white" : "text-primary-slate",
    ]}
  >
    CENTOX KENYA
  </span>
</a>
