---
import LightLogo from "../../assets/centox-standard-logo.svg";
import DarkLogo from "../../assets/centox-standard-logo-dark.svg";
import { SECTION_IDS, siteConfig } from "../../data/site";

interface Props {
  tone?: "light" | "dark";
  height?: "compact" | "large";
  class?: string;
}

const {
  tone = "light",
  height = "compact",
  class: className = "",
} = Astro.props;
const SelectedLogo = tone === "dark" ? DarkLogo : LightLogo;
const heightClass = height === "large" ? "h-16" : "h-8";
---

<a
  href={`/#${SECTION_IDS.hero}`}
  aria-label={`${siteConfig.name}, home`}
  class:list={["inline-flex items-center", className]}
>
  <SelectedLogo
    aria-hidden="true"
    focusable="false"
    class:list={[heightClass, "w-auto"]}
  />
</a>
