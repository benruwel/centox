---
interface Props {
	label: string;
	tone?: "light" | "dark";
	class?: string;
}

const { label, tone = "light", class: className = "" } = Astro.props;
---

{/*
	The dash is a real rule, not an em dash in text — screen readers announce
	punctuation, and a decorative glyph should not be in the accessibility tree.
*/}
<p
	class:list={[
		"flex items-center gap-3 text-xs font-medium uppercase tracking-[0.14em]",
		tone === "dark" ? "text-secondary-teal" : "text-primary-slate",
		className,
	]}
>
	<span aria-hidden="true" class="h-px w-6 shrink-0 bg-secondary-teal"></span>
	{label}
</p>
