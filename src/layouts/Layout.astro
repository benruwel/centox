---
import { Font } from "astro:assets";
import openGraphImage from "../assets/open-graph.png";
import ServiceViewTransitions from "../components/layout/ServiceViewTransitions.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import Contact from "../components/sections/Contact.astro";
import { siteConfig } from "../data/site";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const { title, description = siteConfig.description } = Astro.props;

const pageTitle = title
	? `${title} | ${siteConfig.name}`
	: siteConfig.defaultTitle;
const canonical = Astro.site
	? new URL(Astro.url.pathname, Astro.site).href
	: undefined;
const openGraphImageUrl = new URL(openGraphImage.src, Astro.site ?? Astro.url)
	.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2c3e50" />
    <ServiceViewTransitions />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={openGraphImageUrl} />
    <meta property="og:image:width" content={openGraphImage.width.toString()} />
    <meta
      property="og:image:height"
      content={openGraphImage.height.toString()}
    />
    <meta property="og:image:alt" content={siteConfig.longName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={openGraphImageUrl} />
    <meta name="twitter:image:alt" content={siteConfig.longName} />

    {
      /* Work Sans is body copy and above the fold, so it preloads. Montserrat is
		headings only, which tolerate a swap better than body text, and preloading
		both would have them compete for bandwidth. */
    }
    <Font cssVariable="--font-work-sans" preload />
    <Font cssVariable="--font-montserrat" />

    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-N46CSGP57T"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-N46CSGP57T");
    </script>

    {
      /* Valid only in <head>: keeps the mobile nav usable without JS. Unlayered
		!important is needed to beat preflight's layered `[hidden] { display: none !important }`. */
    }
    <noscript>
      <style>
        @media (max-width: 47.999rem) {
          #nav-menu {
            display: block !important;
          }
        }
      </style>
    </noscript>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-primary-slate focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <Contact />


  </body>
</html>
