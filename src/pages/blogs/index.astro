---
import { getCollection } from "astro:content";
import Container from "../../components/ui/Container.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog">
  <header class="border-b border-hairline bg-surface-subtle py-16 md:py-24">
    <Container>
      <Eyebrow label="Insights" />
      <h1 class="mt-6 max-w-3xl text-4xl sm:text-5xl">Blog</h1>
    </Container>
  </header>

  <section aria-label="Blog posts" class="py-16 md:py-24">
    <Container>
      <ul role="list" class="grid gap-2 md:grid-cols-2">
        {
          posts.map((post) => (
            <li>
              <a
                href={`/blogs/${post.id}`}
                class="flex h-full flex-col border border-hairline bg-surface-subtle p-6 motion-safe:transition-colors hover:border-secondary-teal sm:p-8"
              >
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="text-xs"
                >
                  {post.data.pubDate.toLocaleDateString("en-GB", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                  })}
                </time>
                <h2 class="mt-4 text-xl">{post.data.title}</h2>
                <p class="mt-2 text-sm">{post.data.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>
</Layout>
